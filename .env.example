# Logging settings
MY_LIB_LOG_LEVEL=INFO                       # Root log level: `DEBUG`, `INFO`, `WARNING`, `ERROR`, `CRITICAL`
MY_LIB_LOG_CONSOLE_LEVEL=DEBUG              # Minimum level printed to the console
MY_LIB_LOG_FILE_LEVEL=INFO                  # Minimum level written to the log file
MY_LIB_LOG_FILE_NAME=my-lib.log              # Log file name (written to the logs/ directory in the project root)
MY_LIB_LOG_USE_JSON_FORMATTER=false         # Emit log records as JSON (useful for log aggregators)

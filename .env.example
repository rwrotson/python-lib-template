# Every MY_LIB_* value is optional; defaults live in my_lib.config.Settings.
# Nested sections use a double underscore. Uncomment a line to override it.
# The library reads them only when the application calls load_settings() or setup_logging().

# Logging
# MY_LIB_LOG__LEVEL=INFO                      # DEBUG, INFO, WARNING, ERROR, CRITICAL
# MY_LIB_LOG__CONSOLE_LEVEL=DEBUG
# MY_LIB_LOG__FILE_LEVEL=INFO
# MY_LIB_LOG__FORMAT=console                  # console or json; file logs are always JSON
# MY_LIB_LOG__DIR=./logs                      # file logging is disabled if unset
# MY_LIB_LOG__FILE_NAME=my-lib.log           # basename only; no directory separators
# MY_LIB_LOG__FILE_MAX_BYTES=4194304
# MY_LIB_LOG__FILE_BACKUP_COUNT=5
